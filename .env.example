# Copy to .env and load it into the server environment.
# Public site URL, SMTP and registration: Site Administration → Site Configuration.

# Runtime and storage
HOST=0.0.0.0
PORT=8080
SQLITE_PATH=data/jieli.db
ATTACHMENT_STORAGE_DIR=data/attachments
JIELI_DEPLOYMENT_MODE=self-hosted
DEV=0

# Docker generates /app/data/.env with this secret in its data volume automatically.
# For direct binary runs, generate with: openssl rand -hex 32
SESSION_SECRET=
# Set true when serving over HTTPS.
COOKIE_SECURE=false
# First self-hosted sign-in creates the administrator without email verification.

# Optional Cloudflare R2 attachment storage; defaults to local ATTACHMENT_STORAGE_DIR.
# To enable, uncomment the first five settings below and fill in your R2 values.
# Existing local attachments are not migrated automatically.
# Without Docker: append these settings to the generated data/.env, keep its
# SESSION_SECRET, and restart the script.
# Docker: pass these settings via Compose environment or env_file and recreate
# the container. The project-root .env is not automatically passed to containers.
# ATTACHMENT_STORAGE_DRIVER=r2
# R2_ENDPOINT='https://<account-id>.r2.cloudflarestorage.com'
# R2_BUCKET='<bucket-name>'
# R2_ACCESS_KEY_ID='<access-key-id>'
# R2_SECRET_ACCESS_KEY='<secret-access-key>'
# R2_REGION=auto
# Optional public R2 domain for direct attachment access.
# Leave unset to serve downloads through Jieli without public bucket access.
# R2_PUBLIC_BASE_URL=https://files.example.com

# Optional GitHub / Google OAuth; replace example.com with your site address.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://example.com:8080/web/api/auth/callback/github
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://example.com:8080/web/api/auth/callback/google

# Optional proxy, username reservations and verbose logging.
# TRUSTED_PROXIES=127.0.0.1,::1
# USERNAME_RESERVED_WORDS=
# DEBUG=1
